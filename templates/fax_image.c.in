#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <limits.h>
#include "fax_image.h"

#ifdef FAX_WITH_PNG
#include <png.h>
#endif
#ifdef FAX_WITH_JPEG
#include <setjmp.h>
#include <jpeglib.h>
#include <jerror.h>
#endif
#ifdef FAX_WITH_TIFF
#include <stdint.h>
#include <tiffio.h>
#endif

static void fax_image_error(char *dst, fax_index cap, const char *message)
{
    fax_index i;
    if (dst == (char *)0 || cap == 0UL) return;
    i = 0UL;
    while (message[i] != '\0' && i + 1UL < cap) {
        dst[i] = message[i];
        ++i;
    }
    dst[i] = '\0';
}

static int fax_image_size(fax_index width, fax_index height, size_t *bytes)
{
    volatile fax_index count;
    if (width == 0UL || height == 0UL) return 0;
    if (width > ULONG_MAX / height) return 0;
    count = width * height;
    *bytes = (size_t)count;
    if ((fax_index)(*bytes) != count) return 0;
    return 1;
}

static fax_u16 fax_read_le16(const unsigned char *p)
{
    return (fax_u16)((unsigned int)p[0] | ((unsigned int)p[1] << 8));
}

static fax_u32 fax_read_le32(const unsigned char *p)
{
    return (fax_u32)((unsigned long)p[0] |
        ((unsigned long)p[1] << 8) | ((unsigned long)p[2] << 16) |
        ((unsigned long)p[3] << 24));
}

static long fax_read_le32_signed(const unsigned char *p)
{
    unsigned long value;
    value = fax_read_le32(p);
    if (value & 0x80000000UL) {
        if (value == 0x80000000UL) return LONG_MIN;
        return -(long)((~value) + 1UL);
    }
    return (long)value;
}

static int fax_read_token(FILE *file, char *buffer, size_t capacity)
{
    int ch;
    size_t used;
    used = 0U;
    do {
        ch = fgetc(file);
        if (ch == '#') {
            while (ch != '\n' && ch != EOF) ch = fgetc(file);
        }
    } while (ch != EOF && (ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n' || ch == '\f'));
    if (ch == EOF) return 0;
    while (ch != EOF && ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n' && ch != '\f' && ch != '#') {
        if (used + 1U < capacity) buffer[used++] = (char)ch;
        ch = fgetc(file);
    }
    if (ch == '#') {
        while (ch != '\n' && ch != EOF) ch = fgetc(file);
    } else if (ch == '\r') {
        int next_ch;
        next_ch = fgetc(file);
        if (next_ch != '\n' && next_ch != EOF) ungetc(next_ch, file);
    }
    buffer[used] = '\0';
    return used != 0U;
}

static int fax_decode_pgm(const char *path, fax_image *image, char *error, fax_index error_cap)
{
    FILE *file;
    char token[64];
    unsigned long width, height, maxval;
    size_t bytes;
    fax_u8 *pixels;
    unsigned long i, value;
    int binary;
    file = fopen(path, "rb");
    if (file == (FILE *)0) { fax_image_error(error, error_cap, "cannot open PGM"); return 0; }
    if (!fax_read_token(file, token, sizeof(token)) ||
        (strcmp(token, "P5") != 0 && strcmp(token, "P2") != 0)) {
        fclose(file); fax_image_error(error, error_cap, "unsupported PGM variant (need P2/P5)"); return 0;
    }
    binary = (token[1] == '5');
    if (!fax_read_token(file, token, sizeof(token))) { fclose(file); fax_image_error(error, error_cap, "invalid PGM width"); return 0; }
    width = strtoul(token, (char **)0, 10);
    if (!fax_read_token(file, token, sizeof(token))) { fclose(file); fax_image_error(error, error_cap, "invalid PGM height"); return 0; }
    height = strtoul(token, (char **)0, 10);
    if (!fax_read_token(file, token, sizeof(token))) { fclose(file); fax_image_error(error, error_cap, "invalid PGM maxval"); return 0; }
    maxval = strtoul(token, (char **)0, 10);
    if (width == 0UL || height == 0UL || maxval == 0UL || maxval > 255UL ||
        !fax_image_size(width, height, &bytes)) {
        fclose(file); fax_image_error(error, error_cap, "PGM dimensions/maxval out of range (8-bit required)"); return 0;
    }
    pixels = (fax_u8 *)malloc(bytes);
    if (pixels == (fax_u8 *)0) { fclose(file); fax_image_error(error, error_cap, "out of memory decoding PGM"); return 0; }
    if (binary) {
        if (maxval == 255UL) {
            if (fread(pixels, 1U, bytes, file) != bytes) {
                free(pixels); fclose(file); fax_image_error(error, error_cap, "truncated PGM raster"); return 0;
            }
        } else {
            if (fread(pixels, 1U, bytes, file) != bytes) {
                free(pixels); fclose(file); fax_image_error(error, error_cap, "truncated PGM raster"); return 0;
            }
            for (i = 0UL; i < (unsigned long)bytes; ++i)
                pixels[i] = (fax_u8)(((unsigned long)pixels[i] * 255UL + maxval / 2UL) / maxval);
        }
    } else {
        for (i = 0UL; i < (unsigned long)bytes; ++i) {
            if (!fax_read_token(file, token, sizeof(token))) {
                free(pixels); fclose(file); fax_image_error(error, error_cap, "truncated ASCII PGM raster"); return 0;
            }
            value = strtoul(token, (char **)0, 10);
            if (value > maxval) value = maxval;
            pixels[i] = (fax_u8)((value * 255UL + maxval / 2UL) / maxval);
        }
    }
    fclose(file);
    image->pixels = pixels; image->width = width; image->height = height;
    image->stride = width; image->dpi_x = 0.0; image->dpi_y = 0.0;
    image->format = FAX_IMAGE_PGM; image->selected_page = 0UL;
    return 1;
}

static fax_u8 fax_rgb_gray(unsigned int r, unsigned int g, unsigned int b)
{
    return (fax_u8)((77UL * r + 150UL * g + 29UL * b + 128UL) >> 8);
}

static int fax_decode_bmp(const char *path, fax_image *image, char *error, fax_index error_cap)
{
    FILE *file;
    unsigned char fh[14], dib[40];
    unsigned long offset, dib_size, width, height, row_bytes, palette_count;
    long signed_width, signed_height;
    unsigned int planes, bpp, compression, y;
    long xppm, yppm;
    int top_down;
    unsigned char palette[256][4];
    unsigned char *row;
    fax_u8 *pixels;
    size_t bytes;
    file = fopen(path, "rb");
    if (file == (FILE *)0) { fax_image_error(error, error_cap, "cannot open BMP"); return 0; }
    if (fread(fh, 1U, 14U, file) != 14U || fh[0] != 'B' || fh[1] != 'M') {
        fclose(file); fax_image_error(error, error_cap, "invalid BMP header"); return 0;
    }
    offset = fax_read_le32(fh + 10);
    if (fread(dib, 1U, 4U, file) != 4U) { fclose(file); fax_image_error(error, error_cap, "truncated BMP DIB header"); return 0; }
    dib_size = fax_read_le32(dib);
    if (dib_size < 40UL || dib_size > 4096UL || fread(dib + 4, 1U, 36U, file) != 36U) {
        fclose(file); fax_image_error(error, error_cap, "unsupported BMP DIB header"); return 0;
    }
    signed_width = fax_read_le32_signed(dib + 4);
    signed_height = fax_read_le32_signed(dib + 8);
    if (signed_width <= 0L || signed_height == 0L || signed_height == LONG_MIN) {
        fclose(file); fax_image_error(error, error_cap, "invalid BMP dimensions"); return 0;
    }
    width = (unsigned long)signed_width;
    top_down = (signed_height < 0L);
    height = (unsigned long)(top_down ? -signed_height : signed_height);
    planes = fax_read_le16(dib + 12); bpp = fax_read_le16(dib + 14);
    compression = fax_read_le32(dib + 16);
    xppm = fax_read_le32_signed(dib + 24);
    yppm = fax_read_le32_signed(dib + 28);
    if (xppm < 0L) xppm = 0L;
    if (yppm < 0L) yppm = 0L;
    if (planes != 1U || compression != 0U ||
        !(bpp == 1U || bpp == 4U || bpp == 8U || bpp == 24U || bpp == 32U) ||
        !fax_image_size(width, height, &bytes)) {
        fclose(file); fax_image_error(error, error_cap, "BMP requires BI_RGB 1/4/8/24/32-bpp and valid dimensions"); return 0;
    }
    if (width > (ULONG_MAX - 31UL) / bpp) { fclose(file); fax_image_error(error, error_cap, "BMP row size overflow"); return 0; }
    row_bytes = (((width * bpp + 31UL) / 32UL) * 4UL);
    if ((size_t)row_bytes != row_bytes) { fclose(file); fax_image_error(error, error_cap, "BMP row exceeds addressable memory"); return 0; }
    palette_count = 0UL;
    if (bpp <= 8U) {
        palette_count = fax_read_le32(dib + 32);
        if (palette_count == 0UL) palette_count = 1UL << bpp;
        if (palette_count > (1UL << bpp) || palette_count > 256UL) {
            fclose(file); fax_image_error(error, error_cap, "invalid BMP palette size"); return 0;
        }
        memset(palette, 0, sizeof(palette));
        if (fseek(file, (long)(14UL + dib_size), SEEK_SET) != 0 ||
            fread(palette, 4U, (size_t)palette_count, file) != (size_t)palette_count) {
            fclose(file); fax_image_error(error, error_cap, "truncated BMP palette"); return 0;
        }
    }
    if (offset > (unsigned long)LONG_MAX || fseek(file, (long)offset, SEEK_SET) != 0) {
        fclose(file); fax_image_error(error, error_cap, "invalid BMP pixel offset"); return 0;
    }
    row = (unsigned char *)malloc((size_t)row_bytes);
    pixels = (fax_u8 *)malloc(bytes);
    if (row == (unsigned char *)0 || pixels == (fax_u8 *)0) {
        free(row); free(pixels); fclose(file); fax_image_error(error, error_cap, "out of memory decoding BMP"); return 0;
    }
    for (y = 0U; y < height; ++y) {
        unsigned long dest_y;
        unsigned long xlong;
        dest_y = top_down ? y : height - 1UL - y;
        if (fread(row, 1U, (size_t)row_bytes, file) != (size_t)row_bytes) {
            free(row); free(pixels); fclose(file); fax_image_error(error, error_cap, "truncated BMP pixel data"); return 0;
        }
        for (xlong = 0UL; xlong < width; ++xlong) {
            unsigned int r, g, b, index;
            if (bpp == 24U || bpp == 32U) {
                unsigned long p;
                p = xlong * (bpp / 8U);
                b = row[p]; g = row[p + 1UL]; r = row[p + 2UL];
            } else {
                if (bpp == 8U) index = row[xlong];
                else if (bpp == 4U) index = (xlong & 1UL) ? (row[xlong / 2UL] & 15U) : (row[xlong / 2UL] >> 4);
                else index = (row[xlong / 8UL] >> (7U - (unsigned int)(xlong & 7UL))) & 1U;
                if (index >= palette_count) {
                    free(row); free(pixels); fclose(file); fax_image_error(error, error_cap, "BMP palette index out of range"); return 0;
                }
                b = palette[index][0]; g = palette[index][1]; r = palette[index][2];
            }
            pixels[dest_y * width + xlong] = fax_rgb_gray(r, g, b);
        }
    }
    free(row); fclose(file);
    image->pixels = pixels; image->width = width; image->height = height;
    image->stride = width;
    image->dpi_x = (double)xppm * 0.0254;
    image->dpi_y = (double)yppm * 0.0254;
    image->format = FAX_IMAGE_BMP; image->selected_page = 0UL;
    return 1;
}

#ifdef FAX_WITH_TIFF
static void fax_orient_xy(unsigned int orientation, unsigned long width,
                          unsigned long height, unsigned long x, unsigned long y,
                          unsigned long *out_x, unsigned long *out_y)
{
    switch (orientation) {
    case 2U: *out_x = width - 1UL - x; *out_y = y; break;
    case 3U: *out_x = width - 1UL - x; *out_y = height - 1UL - y; break;
    case 4U: *out_x = x; *out_y = height - 1UL - y; break;
    case 5U: *out_x = y; *out_y = x; break;
    case 6U: *out_x = height - 1UL - y; *out_y = x; break;
    case 7U: *out_x = height - 1UL - y; *out_y = width - 1UL - x; break;
    case 8U: *out_x = y; *out_y = width - 1UL - x; break;
    default: *out_x = x; *out_y = y; break;
    }
}
#endif

#ifdef FAX_WITH_PNG
static int fax_decode_png(const char *path, fax_image *image, char *error, fax_index error_cap)
{
    FILE *file;
    png_structp png_ptr;
    png_infop info_ptr;
    png_uint_32 width, height, xppm, yppm;
    int bit_depth, color_type, passes, pass, phys_unit;
    png_uint_32 y;
    fax_u8 *volatile pixels;
    size_t bytes;
    file = fopen(path, "rb");
    if (file == (FILE *)0) { fax_image_error(error, error_cap, "cannot open PNG"); return 0; }
    png_ptr = png_create_read_struct(PNG_LIBPNG_VER_STRING, (png_voidp)0, (png_error_ptr)0, (png_error_ptr)0);
    if (png_ptr == (png_structp)0) { fclose(file); fax_image_error(error, error_cap, "libpng allocation failed"); return 0; }
    info_ptr = png_create_info_struct(png_ptr);
    if (info_ptr == (png_infop)0) { png_destroy_read_struct(&png_ptr, (png_infopp)0, (png_infopp)0); fclose(file); fax_image_error(error, error_cap, "libpng info allocation failed"); return 0; }
    pixels = (fax_u8 *)0;
    if (setjmp(png_jmpbuf(png_ptr))) {
        free((void *)pixels); png_destroy_read_struct(&png_ptr, &info_ptr, (png_infopp)0); fclose(file);
        fax_image_error(error, error_cap, "PNG decode failed (libpng)"); return 0;
    }
    png_init_io(png_ptr, file);
    png_read_info(png_ptr, info_ptr);
    width = png_get_image_width(png_ptr, info_ptr);
    height = png_get_image_height(png_ptr, info_ptr);
    bit_depth = png_get_bit_depth(png_ptr, info_ptr);
    color_type = png_get_color_type(png_ptr, info_ptr);
    if (!fax_image_size((fax_index)width, (fax_index)height, &bytes)) png_error(png_ptr, "invalid PNG dimensions");
    if (color_type == PNG_COLOR_TYPE_PALETTE) png_set_palette_to_rgb(png_ptr);
    if (color_type == PNG_COLOR_TYPE_GRAY && bit_depth < 8) png_set_expand_gray_1_2_4_to_8(png_ptr);
    if (png_get_valid(png_ptr, info_ptr, PNG_INFO_tRNS)) png_set_tRNS_to_alpha(png_ptr);
    if ((color_type & PNG_COLOR_MASK_ALPHA) || png_get_valid(png_ptr, info_ptr, PNG_INFO_tRNS)) {
        png_color_16 background;
        memset(&background, 0, sizeof(background));
        if (color_type != PNG_COLOR_TYPE_PALETTE && bit_depth == 16) {
            background.gray = 65535U;
            background.red = 65535U; background.green = 65535U; background.blue = 65535U;
        } else {
            background.gray = 255U;
            background.red = 255U; background.green = 255U; background.blue = 255U;
        }
        png_set_background(png_ptr, &background, PNG_BACKGROUND_GAMMA_SCREEN, 0, 1.0);
    }
    if (bit_depth == 16) png_set_strip_16(png_ptr);
    if (color_type == PNG_COLOR_TYPE_RGB || color_type == PNG_COLOR_TYPE_RGB_ALPHA || color_type == PNG_COLOR_TYPE_PALETTE)
        png_set_rgb_to_gray_fixed(png_ptr, PNG_ERROR_ACTION_NONE, 29900, 58700);
    passes = png_set_interlace_handling(png_ptr);
    png_read_update_info(png_ptr, info_ptr);
    if (png_get_channels(png_ptr, info_ptr) != 1 || png_get_bit_depth(png_ptr, info_ptr) != 8)
        png_error(png_ptr, "PNG transform did not produce 8-bit grayscale");
    pixels = (fax_u8 *)malloc(bytes);
    if (pixels == (fax_u8 *)0) png_error(png_ptr, "out of memory decoding PNG");
    for (pass = 0; pass < passes; ++pass)
        for (y = 0U; y < height; ++y)
            png_read_row(png_ptr, (png_bytep)((fax_u8 *)pixels + (size_t)y * (size_t)width), (png_bytep)0);
    png_read_end(png_ptr, info_ptr);
    xppm = yppm = 0U; phys_unit = PNG_RESOLUTION_UNKNOWN;
    if (png_get_pHYs(png_ptr, info_ptr, &xppm, &yppm, &phys_unit) &&
        phys_unit == PNG_RESOLUTION_METER) {
        image->dpi_x = (double)xppm * 0.0254;
        image->dpi_y = (double)yppm * 0.0254;
    } else { image->dpi_x = 0.0; image->dpi_y = 0.0; }
    png_destroy_read_struct(&png_ptr, &info_ptr, (png_infopp)0);
    fclose(file);
    image->pixels = (fax_u8 *)pixels; image->width = (fax_index)width; image->height = (fax_index)height;
    image->stride = (fax_index)width; image->format = FAX_IMAGE_PNG; image->selected_page = 0UL;
    return 1;
}
#endif

#ifdef FAX_WITH_JPEG
struct fax_jpeg_error_mgr { struct jpeg_error_mgr pub; jmp_buf jump; };
static void fax_jpeg_error_exit(j_common_ptr cinfo)
{
    struct fax_jpeg_error_mgr *err;
    err = (struct fax_jpeg_error_mgr *)cinfo->err;
    longjmp(err->jump, 1);
}

static int fax_decode_jpeg(const char *path, fax_image *image, char *error, fax_index error_cap)
{
    FILE *file;
    struct jpeg_decompress_struct *cinfo;
    struct fax_jpeg_error_mgr jerr;
    fax_u8 *volatile pixels;
    volatile int created;
    size_t bytes;
    file = fopen(path, "rb");
    if (file == (FILE *)0) { fax_image_error(error, error_cap, "cannot open JPEG"); return 0; }
    cinfo = (struct jpeg_decompress_struct *)malloc(sizeof(*cinfo));
    if (cinfo == (struct jpeg_decompress_struct *)0) {
        fclose(file); fax_image_error(error, error_cap, "out of memory creating JPEG decoder"); return 0;
    }
    memset(cinfo, 0, sizeof(*cinfo));
    cinfo->err = jpeg_std_error(&jerr.pub);
    jerr.pub.error_exit = fax_jpeg_error_exit;
    pixels = (fax_u8 *)0; created = 0;
    if (setjmp(jerr.jump)) {
        free((void *)pixels);
        if (created) jpeg_destroy_decompress(cinfo);
        free(cinfo); fclose(file);
        fax_image_error(error, error_cap, "JPEG decode failed (libjpeg)"); return 0;
    }
    jpeg_create_decompress(cinfo); created = 1;
    jpeg_stdio_src(cinfo, file);
    jpeg_read_header(cinfo, TRUE);
    if (cinfo->jpeg_color_space == JCS_CMYK || cinfo->jpeg_color_space == JCS_YCCK) {
        jpeg_destroy_decompress(cinfo); created = 0;
        free(cinfo); fclose(file);
        fax_image_error(error, error_cap, "CMYK/YCCK JPEG is not supported by this grayscale adapter"); return 0;
    }
    cinfo->out_color_space = JCS_GRAYSCALE;
    jpeg_start_decompress(cinfo);
    if (cinfo->output_components != 1 || cinfo->output_width == 0UL ||
        cinfo->output_height == 0UL || cinfo->output_width > ULONG_MAX / cinfo->output_height)
        ERREXIT(cinfo, JERR_IMAGE_TOO_BIG);
    bytes = (size_t)(cinfo->output_width * cinfo->output_height);
    if ((fax_index)bytes != cinfo->output_width * cinfo->output_height)
        ERREXIT(cinfo, JERR_IMAGE_TOO_BIG);
    pixels = (fax_u8 *)malloc(bytes);
    if (pixels == (fax_u8 *)0) ERREXIT(cinfo, JERR_OUT_OF_MEMORY);
    while (cinfo->output_scanline < cinfo->output_height) {
        JSAMPROW row;
        row = (JSAMPROW)((fax_u8 *)pixels + (size_t)cinfo->output_scanline * (size_t)cinfo->output_width);
        jpeg_read_scanlines(cinfo, &row, 1U);
    }
    image->dpi_x = 0.0; image->dpi_y = 0.0;
    if (cinfo->density_unit == 1) {
        image->dpi_x = (double)cinfo->X_density; image->dpi_y = (double)cinfo->Y_density;
    } else if (cinfo->density_unit == 2) {
        image->dpi_x = (double)cinfo->X_density * 2.54;
        image->dpi_y = (double)cinfo->Y_density * 2.54;
    }
    image->width = cinfo->output_width; image->height = cinfo->output_height;
    image->stride = cinfo->output_width;
    jpeg_finish_decompress(cinfo); jpeg_destroy_decompress(cinfo); created = 0;
    free(cinfo); fclose(file);
    image->pixels = (fax_u8 *)pixels; image->format = FAX_IMAGE_JPEG; image->selected_page = 0UL;
    return 1;
}

#endif

#ifdef FAX_WITH_TIFF
static fax_u8 fax_tiff_sample_to_u8(unsigned long value, unsigned int bits)
{
    if (bits == 16U) return (fax_u8)((value + 128UL) / 257UL);
    return (fax_u8)value;
}

static unsigned long fax_tiff_get_sample(const unsigned char *row, unsigned long x,
                                         unsigned int sample, unsigned int bits,
                                         unsigned int samples)
{
    unsigned long index;
    index = x * samples + sample;
    if (bits == 1U) return (row[index / 8UL] >> (7U - (unsigned int)(index & 7UL))) & 1UL;
    if (bits == 2U) return (row[index / 4UL] >> (6U - 2U * (unsigned int)(index & 3UL))) & 3UL;
    if (bits == 4U) return (row[index / 2UL] >> ((index & 1UL) ? 0U : 4U)) & 15UL;
    if (bits == 8U) return row[index];
    if (bits == 16U) {
        const unsigned short *p;
        p = (const unsigned short *)row;
        return p[index];
    }
    return 0UL;
}

static fax_u8 fax_tiff_convert_pixel(const unsigned char *row, unsigned long x,
                                     unsigned int bits, unsigned int samples,
                                     unsigned int photo, unsigned int alpha_mode,
                                     unsigned short *red_map, unsigned short *green_map,
                                     unsigned short *blue_map)
{
    unsigned long r, g, b, a, idx;
    if (photo == PHOTOMETRIC_PALETTE) {
        idx = fax_tiff_get_sample(row, x, 0U, bits, samples);
        r = red_map[idx] / 257UL; g = green_map[idx] / 257UL; b = blue_map[idx] / 257UL;
        return fax_rgb_gray((unsigned int)r, (unsigned int)g, (unsigned int)b);
    }
    if (photo == PHOTOMETRIC_MINISWHITE || photo == PHOTOMETRIC_MINISBLACK) {
        r = fax_tiff_get_sample(row, x, 0U, bits, samples);
        if (bits == 1U) r = r ? 255UL : 0UL;
        else r = fax_tiff_sample_to_u8(r, bits);
        if (photo == PHOTOMETRIC_MINISWHITE) r = 255UL - r;
        return (fax_u8)r;
    }
    r = fax_tiff_sample_to_u8(fax_tiff_get_sample(row, x, 0U, bits, samples), bits);
    g = fax_tiff_sample_to_u8(fax_tiff_get_sample(row, x, 1U, bits, samples), bits);
    b = fax_tiff_sample_to_u8(fax_tiff_get_sample(row, x, 2U, bits, samples), bits);
    if (alpha_mode != 0U && samples >= 4U) {
        a = fax_tiff_sample_to_u8(fax_tiff_get_sample(row, x, 3U, bits, samples), bits);
        if (alpha_mode == 2U) {
            r = r + (255UL - a); g = g + (255UL - a); b = b + (255UL - a);
            if (r > 255UL) r = 255UL;
            if (g > 255UL) g = 255UL;
            if (b > 255UL) b = 255UL;
        } else {
            r = (r * a + 255UL * (255UL - a) + 127UL) / 255UL;
            g = (g * a + 255UL * (255UL - a) + 127UL) / 255UL;
            b = (b * a + 255UL * (255UL - a) + 127UL) / 255UL;
        }
    }
    return fax_rgb_gray((unsigned int)r, (unsigned int)g, (unsigned int)b);
}

static int fax_decode_tiff(const char *path, unsigned long page_index,
                           fax_image *image, char *error, fax_index error_cap)
{
    TIFF *tif;
    uint32_t width, height, tile_width, tile_height;
    uint16_t bits, samples, photo, planar, orientation, sample_format, res_unit;
    uint16_t extra_count, *extra_types;
    unsigned int alpha;
    float xres, yres;
    unsigned long output_width, output_height;
    unsigned short *red_map, *green_map, *blue_map;
    size_t bytes;
    fax_u8 *pixels;
    unsigned char *buffer;
    tmsize_t buffer_size;
    unsigned long x, y;
    int tiled;
    tif = TIFFOpen(path, "rb");
    if (tif == (TIFF *)0) { fax_image_error(error, error_cap, "cannot open TIFF"); return 0; }
    if (page_index > 65535UL || !TIFFSetDirectory(tif, (tdir_t)page_index)) {
        TIFFClose(tif); fax_image_error(error, error_cap, "requested TIFF page/directory does not exist"); return 0;
    }
    if (!TIFFGetField(tif, TIFFTAG_IMAGEWIDTH, &width) ||
        !TIFFGetField(tif, TIFFTAG_IMAGELENGTH, &height)) {
        TIFFClose(tif); fax_image_error(error, error_cap, "TIFF is missing dimensions"); return 0;
    }
    TIFFGetFieldDefaulted(tif, TIFFTAG_BITSPERSAMPLE, &bits);
    TIFFGetFieldDefaulted(tif, TIFFTAG_SAMPLESPERPIXEL, &samples);
    TIFFGetFieldDefaulted(tif, TIFFTAG_PHOTOMETRIC, &photo);
    TIFFGetFieldDefaulted(tif, TIFFTAG_PLANARCONFIG, &planar);
    TIFFGetFieldDefaulted(tif, TIFFTAG_ORIENTATION, &orientation);
    TIFFGetFieldDefaulted(tif, TIFFTAG_SAMPLEFORMAT, &sample_format);
    TIFFGetFieldDefaulted(tif, TIFFTAG_RESOLUTIONUNIT, &res_unit);
    xres = 0.0F; yres = 0.0F;
    TIFFGetField(tif, TIFFTAG_XRESOLUTION, &xres);
    TIFFGetField(tif, TIFFTAG_YRESOLUTION, &yres);
    alpha = 0U; extra_count = 0U; extra_types = (uint16_t *)0;
    if (TIFFGetField(tif, TIFFTAG_EXTRASAMPLES, &extra_count, &extra_types) && extra_count > 0U) {
        if (extra_types[0] == EXTRASAMPLE_UNASSALPHA) alpha = 1U;
        else if (extra_types[0] == EXTRASAMPLE_ASSOCALPHA) alpha = 2U;
    }
    red_map = green_map = blue_map = (unsigned short *)0;
    if (photo == PHOTOMETRIC_PALETTE && !TIFFGetField(tif, TIFFTAG_COLORMAP, &red_map, &green_map, &blue_map)) {
        TIFFClose(tif); fax_image_error(error, error_cap, "TIFF palette image has no color map"); return 0;
    }
    if (!fax_image_size((fax_index)width, (fax_index)height, &bytes) ||
        !(bits == 1U || bits == 2U || bits == 4U || bits == 8U || bits == 16U) ||
        sample_format != SAMPLEFORMAT_UINT ||
        planar != PLANARCONFIG_CONTIG || orientation < ORIENTATION_TOPLEFT || orientation > ORIENTATION_LEFTBOT ||
        !(((photo == PHOTOMETRIC_MINISWHITE || photo == PHOTOMETRIC_MINISBLACK) && samples == 1U && (bits == 1U || bits == 8U || bits == 16U)) ||
          (photo == PHOTOMETRIC_PALETTE && samples == 1U && bits <= 8U) ||
          (photo == PHOTOMETRIC_RGB && (samples == 3U || (samples == 4U && alpha)) && (bits == 8U || bits == 16U)))) {
        TIFFClose(tif); fax_image_error(error, error_cap, "unsupported TIFF layout (need unsigned contig gray/palette/RGB, 1/2/4/8/16-bit samples where supported)"); return 0;
    }
    if (photo == PHOTOMETRIC_PALETTE && bits == 16U) {
        TIFFClose(tif); fax_image_error(error, error_cap, "16-bit TIFF palette is unsupported"); return 0;
    }
    if (orientation >= ORIENTATION_LEFTTOP) {
        output_width = height; output_height = width;
    } else { output_width = width; output_height = height; }
    if (!fax_image_size(output_width, output_height, &bytes)) {
        TIFFClose(tif); fax_image_error(error, error_cap, "invalid oriented TIFF dimensions"); return 0;
    }
    pixels = (fax_u8 *)malloc(bytes);
    if (pixels == (fax_u8 *)0) { TIFFClose(tif); fax_image_error(error, error_cap, "out of memory decoding TIFF"); return 0; }
    tiled = TIFFIsTiled(tif);
    if (!tiled) {
        buffer_size = TIFFScanlineSize(tif);
        if (buffer_size <= 0) { free(pixels); TIFFClose(tif); fax_image_error(error, error_cap, "invalid TIFF scanline size"); return 0; }
        buffer = (unsigned char *)_TIFFmalloc(buffer_size);
        if (buffer == (unsigned char *)0) { free(pixels); TIFFClose(tif); fax_image_error(error, error_cap, "out of memory decoding TIFF scanline"); return 0; }
        for (y = 0UL; y < height; ++y) {
            if (TIFFReadScanline(tif, buffer, (uint32_t)y, 0) < 0) {
                _TIFFfree(buffer); free(pixels); TIFFClose(tif); fax_image_error(error, error_cap, "TIFF scanline decompression failed"); return 0;
            }
            for (x = 0UL; x < width; ++x) {
                unsigned long dest_x, dest_y;
                fax_orient_xy(orientation, width, height, x, y, &dest_x, &dest_y);
                pixels[dest_y * output_width + dest_x] = fax_tiff_convert_pixel(buffer, x, bits, samples, photo, alpha, red_map, green_map, blue_map);
            }
        }
        _TIFFfree(buffer);
    } else {
        if (!TIFFGetField(tif, TIFFTAG_TILEWIDTH, &tile_width) || !TIFFGetField(tif, TIFFTAG_TILELENGTH, &tile_height) ||
            tile_width == 0U || tile_height == 0U) {
            free(pixels); TIFFClose(tif); fax_image_error(error, error_cap, "invalid TIFF tile dimensions"); return 0;
        }
        buffer_size = TIFFTileSize(tif);
        if (buffer_size <= 0) { free(pixels); TIFFClose(tif); fax_image_error(error, error_cap, "invalid TIFF tile size"); return 0; }
        buffer = (unsigned char *)_TIFFmalloc(buffer_size);
        if (buffer == (unsigned char *)0) { free(pixels); TIFFClose(tif); fax_image_error(error, error_cap, "out of memory decoding TIFF tile"); return 0; }
        for (y = 0UL; y < height; y += tile_height) {
            for (x = 0UL; x < width; x += tile_width) {
                unsigned long ty;
                tmsize_t tile_row_size;
                if (TIFFReadTile(tif, buffer, (uint32_t)x, (uint32_t)y, 0, 0) < 0) {
                    _TIFFfree(buffer); free(pixels); TIFFClose(tif); fax_image_error(error, error_cap, "TIFF tile decompression failed"); return 0;
                }
                tile_row_size = TIFFTileRowSize(tif);
                if (tile_row_size <= 0 || (uint64_t)tile_row_size * (uint64_t)tile_height > (uint64_t)buffer_size) {
                    _TIFFfree(buffer); free(pixels); TIFFClose(tif); fax_image_error(error, error_cap, "invalid TIFF tile row size"); return 0;
                }
                for (ty = 0UL; ty < tile_height && y + ty < height; ++ty) {
                    unsigned long tx;
                    unsigned char *tile_row;
                    tile_row = buffer + (size_t)ty * (size_t)tile_row_size;
                    for (tx = 0UL; tx < tile_width && x + tx < width; ++tx) {
                        unsigned long dest_x, dest_y;
                        fax_orient_xy(orientation, width, height, x + tx, y + ty, &dest_x, &dest_y);
                        pixels[dest_y * output_width + dest_x] = fax_tiff_convert_pixel(tile_row, tx, bits, samples, photo, alpha, red_map, green_map, blue_map);
                    }
                }
            }
        }
        _TIFFfree(buffer);
    }
    TIFFClose(tif);
    image->pixels = pixels; image->width = output_width; image->height = output_height; image->stride = output_width;
    if (res_unit == RESUNIT_CENTIMETER) { xres = (float)(xres * 2.54); yres = (float)(yres * 2.54); }
    if (res_unit != RESUNIT_INCH && res_unit != RESUNIT_CENTIMETER) { xres = 0.0F; yres = 0.0F; }
    if (orientation >= ORIENTATION_LEFTTOP) {
        image->dpi_x = (double)yres; image->dpi_y = (double)xres;
    } else {
        image->dpi_x = (double)xres; image->dpi_y = (double)yres;
    }
    image->format = FAX_IMAGE_TIFF; image->selected_page = page_index;
    return 1;
}
#endif

const char *FAX_CALL fax_image_format_name(int format)
{
    switch (format) {
    case FAX_IMAGE_PGM: return "PGM";
    case FAX_IMAGE_BMP: return "BMP";
    case FAX_IMAGE_PNG: return "PNG";
    case FAX_IMAGE_JPEG: return "JPEG";
    case FAX_IMAGE_TIFF: return "TIFF";
    default: return "unknown";
    }
}

void FAX_CALL fax_image_release(fax_image *image)
{
    if (image == (fax_image *)0) return;
    free(image->pixels);
    memset(image, 0, sizeof(*image));
}

int FAX_CALL fax_image_load_file(const char *path, unsigned long page_index,
                                 fax_image *image, char *error_text,
                                 fax_index error_capacity)
{
    FILE *file;
    unsigned char signature[8];
    size_t got;
    int result;
    if (image == (fax_image *)0 || path == (const char *)0) {
        fax_image_error(error_text, error_capacity, "invalid image loader arguments"); return 0;
    }
    memset(image, 0, sizeof(*image));
    if (error_text != (char *)0 && error_capacity > 0UL) error_text[0] = '\0';
    file = fopen(path, "rb");
    if (file == (FILE *)0) { fax_image_error(error_text, error_capacity, "cannot open input file"); return 0; }
    got = fread(signature, 1U, sizeof(signature), file);
    fclose(file);
    result = 0;
    if (got >= 2U && signature[0] == 'P' && (signature[1] == '5' || signature[1] == '2')) {
        if (page_index != 0UL) { fax_image_error(error_text, error_capacity, "page selection is only valid for TIFF"); return 0; }
        result = fax_decode_pgm(path, image, error_text, error_capacity);
    } else if (got >= 2U && signature[0] == 'B' && signature[1] == 'M') {
        if (page_index != 0UL) { fax_image_error(error_text, error_capacity, "page selection is only valid for TIFF"); return 0; }
        result = fax_decode_bmp(path, image, error_text, error_capacity);
    } else if (got >= 8U && signature[0] == 137U && signature[1] == 80U && signature[2] == 78U && signature[3] == 71U && signature[4] == 13U && signature[5] == 10U && signature[6] == 26U && signature[7] == 10U) {
#ifdef FAX_WITH_PNG
        if (page_index != 0UL) { fax_image_error(error_text, error_capacity, "page selection is only valid for TIFF"); return 0; }
        result = fax_decode_png(path, image, error_text, error_capacity);
#else
        fax_image_error(error_text, error_capacity, "PNG support not compiled in (build with FAX_WITH_PNG and libpng)");
#endif
    } else if (got >= 2U && signature[0] == 0xffU && signature[1] == 0xd8U) {
#ifdef FAX_WITH_JPEG
        if (page_index != 0UL) { fax_image_error(error_text, error_capacity, "page selection is only valid for TIFF"); return 0; }
        result = fax_decode_jpeg(path, image, error_text, error_capacity);
#else
        fax_image_error(error_text, error_capacity, "JPEG support not compiled in (build with FAX_WITH_JPEG and libjpeg)");
#endif
    } else if (got >= 4U && ((signature[0] == 'I' && signature[1] == 'I' && signature[2] == 42U && signature[3] == 0U) ||
                             (signature[0] == 'M' && signature[1] == 'M' && signature[2] == 0U && signature[3] == 42U))) {
#ifdef FAX_WITH_TIFF
        result = fax_decode_tiff(path, page_index, image, error_text, error_capacity);
#else
        fax_image_error(error_text, error_capacity, "TIFF support not compiled in (build with FAX_WITH_TIFF and libtiff)");
#endif
    } else {
        fax_image_error(error_text, error_capacity, "unknown image format (supported: PGM, BMP, and enabled PNG/JPEG/TIFF)");
    }
    return result;
}
